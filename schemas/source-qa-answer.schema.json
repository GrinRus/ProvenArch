{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/acp/schemas/source-qa-answer.schema.json",
  "title": "ACP Proposal Source QA Answer",
  "type": "object",
  "required": [
    "version",
    "source_run_id",
    "answer_digest",
    "proposal_title",
    "question",
    "answer_generated_at",
    "citations",
    "unresolved",
    "created_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "answer_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposal_title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operator_note": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/acp/schemas/workspace.schema.json",
  "title": "ACP Workspace Manifest",
  "type": "object",
  "required": [
    "version",
    "repos"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repo"
      }
    },
    "docs": {
      "$ref": "#/$defs/docs"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "git_url": {
          "type": "string",
          "minLength": 1
        },
        "analysis": {
          "$ref": "#/$defs/repoAnalysis"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "git_url"
            ]
          }
        },
        {
          "required": [
            "git_url"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "repoAnalysis": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "docs": {
      "type": "object",
      "properties": {
        "imports_path": {
          "type": "string",
          "minLength": 1,
          "default": "./docs/imports"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/runtimeProfile"
        }
      },
      "additionalProperties": false
    },
    "runtimeProfile": {
      "type": "object",
      "properties": {
        "timeouts": {
          "$ref": "#/$defs/runtimeTimeouts"
        },
        "execution": {
          "$ref": "#/$defs/runtimeExecution"
        }
      },
      "additionalProperties": false
    },
    "runtimeTimeouts": {
      "type": "object",
      "properties": {
        "step_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "heartbeat_sec": {
          "type": "integer",
          "minimum": 1
        },
        "pipeline_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "pipeline_kill_grace_sec": {
          "type": "integer",
          "minimum": 1
        },
        "api_ready_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "api_init_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "ui_init_poll_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "ui_cancel_poll_timeout_sec": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "runtimeExecution": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel"
          ]
        },
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "failure_policy": {
          "type": "string",
          "enum": [
            "fail_fast",
            "best_effort"
          ]
        },
        "shard_discovery": {
          "$ref": "#/$defs/runtimeShardDiscovery"
        }
      },
      "additionalProperties": false
    },
    "runtimeShardDiscovery": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "heuristics",
            "semantic"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

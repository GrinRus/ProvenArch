{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/acp/schemas/taskresult.schema.json",
  "title": "ACP TaskResult",
  "type": "object",
  "required": [
    "meta",
    "summary",
    "changeset"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "task_id",
        "step_id",
        "runtime",
        "started_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string"
        },
        "runtime": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "workspace": {
          "type": "string"
        },
        "shard_id": {
          "type": "string"
        },
        "repo_scope": {
          "type": "string"
        },
        "repo_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "string"
    },
    "changeset": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "debug": {
      "type": "object"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "repo",
        "path"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "lines": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "excerpt_hash": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "confidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "observation",
            "inference",
            "assertion"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object"
        },
        "owner_team_id": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "type",
        "from",
        "to",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "title",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": true
    },
    "doc_artifact": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json",
            "yaml",
            "text",
            "html",
            "pdf",
            "other"
          ]
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "upsert_entity",
            "remove_entity",
            "upsert_edge",
            "remove_edge",
            "add_finding",
            "add_doc_artifact",
            "add_question",
            "set_coverage"
          ]
        },
        "entity": {
          "$ref": "#/$defs/entity"
        },
        "entity_id": {
          "type": "string"
        },
        "edge": {
          "$ref": "#/$defs/edge"
        },
        "edge_id": {
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/finding"
        },
        "doc_artifact": {
          "$ref": "#/$defs/doc_artifact"
        },
        "question": {
          "$ref": "#/$defs/question"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "reason": {
          "type": "string"
        },
        "target_path": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "upsert_entity"
              }
            }
          },
          "then": {
            "required": [
              "entity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "remove_entity"
              }
            }
          },
          "then": {
            "required": [
              "entity_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "upsert_edge"
              }
            }
          },
          "then": {
            "required": [
              "edge"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "remove_edge"
              }
            }
          },
          "then": {
            "required": [
              "edge_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "add_finding"
              }
            }
          },
          "then": {
            "required": [
              "finding"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "add_doc_artifact"
              }
            }
          },
          "then": {
            "required": [
              "doc_artifact"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "add_question"
              }
            }
          },
          "then": {
            "required": [
              "question"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "set_coverage"
              }
            }
          },
          "then": {
            "required": [
              "coverage"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}

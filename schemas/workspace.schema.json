{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/acp/schemas/workspace.schema.json",
  "title": "ACP Workspace Manifest",
  "type": "object",
  "required": [
    "version",
    "repos"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repo"
      }
    },
    "docs": {
      "$ref": "#/$defs/docs"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "git_url": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "git_url"
            ]
          }
        },
        {
          "required": [
            "git_url"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "docs": {
      "type": "object",
      "properties": {
        "imports_path": {
          "type": "string",
          "minLength": 1,
          "default": "./docs/imports"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "timeouts": {
          "$ref": "#/$defs/runtimeTimeouts"
        }
      },
      "additionalProperties": false
    },
    "runtimeTimeouts": {
      "type": "object",
      "properties": {
        "step_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "heartbeat_sec": {
          "type": "integer",
          "minimum": 1
        },
        "pipeline_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "pipeline_kill_grace_sec": {
          "type": "integer",
          "minimum": 1
        },
        "api_ready_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "api_init_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "ui_init_poll_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "ui_cancel_poll_timeout_sec": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

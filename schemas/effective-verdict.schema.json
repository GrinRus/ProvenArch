{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/acp/schemas/effective-verdict.schema.json",
  "title": "ACP Effective Technical Verdict",
  "type": "object",
  "required": [
    "version",
    "kind",
    "authority",
    "run_id",
    "generated_at",
    "provider_verdict_path",
    "provider_verdict_sha256",
    "verdict",
    "checked_paths",
    "fixed_paths",
    "audit",
    "technical_issues",
    "advisory_issues"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "effective"},
    "authority": {"type": "string", "const": "orchestrator"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "provider_verdict_path": {"type": "string", "minLength": 1},
    "provider_verdict_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"type": "string", "enum": ["PASS", "FAIL"]},
    "summary": {"type": "string"},
    "checked_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "fixed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "technical_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "advisory_issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/advisory_issue"}
    },
    "audit": {"$ref": "#/$defs/audit"}
  },
  "$defs": {
    "line_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["repo", "path"],
      "properties": {
        "repo": {"type": "string", "minLength": 1}, "ref": {"type": "string"},
        "path": {"type": "string", "minLength": 1}, "lines": {"$ref": "#/$defs/line_range"},
        "excerpt_hash": {"type": "string"}, "excerpt": {"type": "string"}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "confidence"],
      "properties": {
        "kind": {"type": "string", "enum": ["observation", "inference", "assertion"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "title", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "severity": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}, "description": {"type": "string"},
        "rule_id": {"type": "string"}, "related_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1},
        "priority": {"type": "string"}, "related_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1}, "severity": {"type": "string", "enum": ["error", "warning"]},
        "message": {"type": "string", "minLength": 1}, "path": {"type": "string"},
        "document_id": {"type": "string"}, "citation_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "advisory_issue": {
      "type": "object",
      "required": ["source", "match_key", "code", "severity", "message"],
      "properties": {
        "source": {"type": "string", "const": "provider"},
        "match_key": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "const": "warning"},
        "message": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "document_id": {"type": "string"},
        "citation_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["status", "error_count", "warning_count", "issue_codes"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "warn", "fail"]},
        "error_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "issue_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
